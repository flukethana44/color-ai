# Copy this file to .env and fill in your real values.
# .env is already excluded via .gitignore — never commit real keys.

# REQUIRED: your AI image generation provider API key.
# This implementation calls OpenAI's Images API by default.
OPENAI_API_KEY=sk-your-key-here

# OPTIONAL — sensible defaults are used if omitted.
PORT=3000
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
