# Copy this file to .env and fill in your real values.
# .env is already excluded via .gitignore — never commit real keys.

# Select one: modelark, huggingface, openai, pollinations, local.
IMAGE_PROVIDER=modelark
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=
MODELARK_API_KEY=

# OPTIONAL — sensible defaults are used if omitted.
PORT=3000
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
MODELARK_BASE_URL=https://ark.ap-southeast-1.bytepluses.com/api/v3
MODELARK_IMAGE_MODEL=seedream-4-0-250828
MODELARK_IMAGE_SIZE=2K
